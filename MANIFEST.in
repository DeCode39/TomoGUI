include LICENSE README.md CHANGELOG.md THIRD_PARTY_NOTICES.md
recursive-include src/tomogui/static *
recursive-include src/tomogui/assets *
recursive-include src/tomogui/resources/workflow *.py *.yaml *.sh *.txt *.json *.md LICENSE
recursive-include tests *.py *.cjs
recursive-include docs *.md
recursive-include release *.py *.md
prune tests/__pycache__
prune .test-output
global-exclude __pycache__ *.py[cod]
